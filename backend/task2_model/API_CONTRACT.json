{
  "openapi": "3.1.0",
  "info": {
    "title": "AeroMatrix Task 2 model",
    "version": "1.0.0"
  },
  "paths": {
    "/task2/predict": {
      "post": {
        "summary": "Prediction",
        "operationId": "prediction_task2_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/task2/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_task2_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Observation": {
        "properties": {
          "station": {
            "type": "string",
            "title": "Station"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "available_at": {
            "type": "string",
            "title": "Available At"
          },
          "pollutant": {
            "type": "string",
            "enum": [
              "pm25",
              "pm10"
            ],
            "title": "Pollutant"
          },
          "value": {
            "type": "number",
            "minimum": 0.0,
            "title": "Value"
          },
          "category": {
            "type": "string",
            "const": "MEASURED",
            "title": "Category"
          },
          "units": {
            "type": "string",
            "const": "ug/m3",
            "title": "Units"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "station",
          "timestamp",
          "available_at",
          "pollutant",
          "value",
          "category",
          "units"
        ],
        "title": "Observation"
      },
      "Request": {
        "properties": {
          "station": {
            "type": "string",
            "title": "Station"
          },
          "pollutant": {
            "type": "string",
            "enum": [
              "pm25",
              "pm10"
            ],
            "title": "Pollutant"
          },
          "cutoff": {
            "type": "string",
            "title": "Cutoff"
          },
          "excluded_station": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Excluded Station"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Observations"
          },
          "weather": {
            "additionalProperties": true,
            "type": "object",
            "title": "Weather"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "station",
          "pollutant",
          "cutoff",
          "observations"
        ],
        "title": "Request"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
# Copy to .env beside this file. Never put provider keys in React or the ZIP.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# LLM_API_KEY is an alternative for compatible providers.
LLM_API_KEY=
# Leave blank for the provider default. Ollama: http://127.0.0.1:11434
LLM_BASE_URL=
AEROMATRIX_ML_API_URL=http://127.0.0.1:8000
AEROMATRIX_SIMULATION_API_URL=
# Current air-quality model data (same source as the dashboard) when the ML backend has no current value. Empty disables it.
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
CHATBOT_HOST=127.0.0.1
CHATBOT_PORT=8010
CHATBOT_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5178,http://localhost:5178,http://127.0.0.1:4178
# Required for a non-loopback bind. Use through your application's server proxy.
CHATBOT_API_KEY=
LLM_TIMEOUT_SECONDS=60
ML_TIMEOUT_SECONDS=15
HISTORY_RETENTION_HOURS=24
HISTORY_MAX_TURNS=12
REQUESTS_PER_MINUTE=30
MAX_SESSIONS=1000

# Copy this file to `.env` (same folder) and fill in what you have. Restart `npm run dev` after editing.

# RECOMMENDED — free Cesium ion token (https://ion.cesium.com/signup → Access Tokens → Default token).
# Enables the "Photorealistic 3D city" (Google Photorealistic 3D Tiles via Cesium ion: real textured
# buildings, trees and terrain), plus Cesium World Terrain and Cesium OSM Buildings.
VITE_CESIUM_ION_TOKEN=

# OPTIONAL — Google Maps Platform API key with the "Map Tiles API" enabled. Used for photorealistic
# tiles directly from Google instead of via Cesium ion. Not needed if the ion token above is set.
VITE_GOOGLE_MAPS_API_KEY=

# OPTIONAL — backend URL if the FastAPI server is not on http://localhost:8000
# VITE_API_URL=

# Trained model service (backend/trained_model). RUN_AEROMATRIX.bat sets this automatically.
# VITE_AEROMATRIX_API_URL=http://127.0.0.1:8000

# Landing page address for the "Back to site" button (default http://localhost:3000/).
# VITE_LANDING_URL=http://localhost:3000/

# Open-Meteo air-quality model data and weather (no API key; free tier ~10,000 calls/day per IP). Minutes between refreshes; minimum 5.
VITE_LIVE_REFRESH_MINUTES=60

# AeroSage assistant service (backend/chatbot). URL only: provider keys belong in backend/chatbot/.env.
VITE_CHATBOT_API_URL=http://127.0.0.1:8010

# Task 2 model service (backend/task2_model, 127.0.0.1:8030). The Vite dev/preview server proxies
# /task2/* to it; set TASK2_API_TARGET (a server-side variable, not VITE_) to change the address.
# TASK2_API_TARGET=http://127.0.0.1:8030

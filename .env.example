# Copy this file to `.env` (same folder) and fill in what you have. Restart `npm run dev` after editing.

# RECOMMENDED — free Cesium ion token (https://ion.cesium.com/signup → Access Tokens → Default token).
# Enables the "Photorealistic 3D city" (Google Photorealistic 3D Tiles via Cesium ion: real textured
# buildings, trees and terrain), plus Cesium World Terrain and Cesium OSM Buildings.
VITE_CESIUM_ION_TOKEN=

# OPTIONAL — Google Maps Platform API key with the "Map Tiles API" enabled. Used for photorealistic
# tiles directly from Google instead of via Cesium ion. Not needed if the ion token above is set.
VITE_GOOGLE_MAPS_API_KEY=

# OPTIONAL — backend URL if the FastAPI server is not on http://localhost:8000
# VITE_API_URL=
